<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Account Activation</title>
  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f8fafc; padding: 20px; }
    .card { max-width: 500px; margin: 0 auto; background: #ffffff; padding: 30px; border-radius: 16px; border: 1px solid #e2e8f0; }
    .logo { color: #0284c7; font-size: 24px; font-weight: bold; text-align: center; }
    .code { font-size: 32px; letter-spacing: 6px; font-weight: 800; color: #0f172a; text-align: center; margin: 25px 0; background: #f1f5f9; padding: 15px; border-radius: 12px; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">EduFlow LMS</div>
    <h2>Hello <%= user.name %>,</h2>
    <p>Thank you for registering on EduFlow LMS. Please use the activation code below to activate your account:</p>
    <div class="code"><%= activationCode %></div>
    <p>This code will expire in 5 minutes.</p>
  </div>
</body>
</html>
